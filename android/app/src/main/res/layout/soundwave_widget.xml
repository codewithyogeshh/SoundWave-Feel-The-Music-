<?xml version="1.0" encoding="utf-8"?>
<!-- A single-row widget: cover, title/artist, a hairline progress bar and the
     three transport buttons. The two soft glow circles behind the content are
     tinted with the album's colours and pulsed in time with the music. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soundwave_widget_background"
    android:padding="1dp">

    <ImageView
        android:id="@+id/widget_glow"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-70dp"
        android:layout_marginTop="-110dp"
        android:alpha="0.2"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow" />

    <ImageView
        android:id="@+id/widget_glow_secondary"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-70dp"
        android:layout_marginBottom="-90dp"
        android:alpha="0.14"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingEnd="9dp">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/widget_art_ring"
            android:contentDescription="Album art"
            android:padding="1.5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:text="SoundWave"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="2dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Previous song"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_previous" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Play or pause"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next song"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</FrameLayout>
