<?xml version="1.0" encoding="utf-8"?>
<!-- White radial falloff; the widget tints it with the current song's colour
     and pulses its alpha, so the same drawable serves every track. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:centerColor="#99FFFFFF"
        android:endColor="#00FFFFFF"
        android:gradientRadius="95dp"
        android:startColor="#CCFFFFFF"
        android:type="radial" />
</shape>
